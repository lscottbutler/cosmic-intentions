.env
.env.*
*.pem
*.key
*.p12
secrets.json
service-account*.json

# dependencies (regenerable — never commit)
node_modules/

# Vite build output (generated by `npm run build` — Netlify builds it on deploy)
dist/

# Playwright test artifacts
test-results/
playwright-report/
/playwright/.cache/

# temp / scratch
_tmp_docx_unpack/

# oversized image folders — back these up outside git (too large for the repo)
images/xxx image sort/
images/column-spacers/
images/player-psd-mockups/

# unused image/asset folders — kept on disk, removed from git to cut repo bloat (2026-06-18)
images/encouragements/
images/voice-overs/
images/repository/
images/svg-library/

# source media + scratch — keep local, never commit (avoid repo bloat)
MP4/
*.mp4

# PSD source masters — keep local, never commit (avoid repo bloat); JPGs are the web assets
*.psd

# gratitude SOURCE pool — 658MB of full-size originals (curated in "gratitude-Episode N/").
# Keep local as the archive; ONLY the compressed episode-<N>/ outputs + manifest.json ship.
# Rebuild outputs with: node scripts/build-gratitude-episodes.js
images/gratitude/gratitude-Episode*/

# generated standalone build (regenerate with scripts/build-standalone.py) — bundles ~70MB of art
standalone-3mv/

# marketing department — private strategy/copy working docs (never publish to live site)
marketing/

# knowledge pack for the CI Marketing Claude Project — copies of private business/
# marketing docs; keep out of git (upload to the Claude Project by hand)
CI-KNOWLEDGE/

